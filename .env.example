OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...
LLM_PROVIDER=openai
# LLM_PROVIDER=gemini
LLM_MODEL=gpt-4o
# LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
LLM_BASE_URL=

APP_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database – leave unset for SQLite, or use Postgres:
# DATABASE_URL=postgresql://jobagent:jobagent@localhost:5432/jobagent

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

# Scheduler
ENABLE_SCHEDULER=true
SCAN_CRON_HOURS=6,18

SERPER_API_KEY=
DATA_DIR=data

# Alerts
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
DEFAULT_ALERT_MIN_SCORE=4.0
